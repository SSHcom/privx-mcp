# TOML is optional. Load order: file (skipped if missing) → defaults → env overrides → validation.
# PRIVX_MCP_CONFIG=/path/to/privx-mcp-config.toml

# [server]
SERVER_NAME=privx-mcp-server
SERVER_VERSION=dev
SERVER_PUBLIC_URL=http://localhost:8181
# oauth (default) or m2m. Replaces the file value when set.
# SERVER_AUTH_MODE=oauth
# Whole mapping string. Replaces the file value. Each secret must be at least 32 characters.
# SERVER_SERVICE_SECRETS=svc-ci <secret>|svc-nightly <secret>
# SERVER_LISTEN_ADDR=:8181
# SERVER_LOG_FILE=/var/log/privx-mcp/privx-mcp.log
# SERVER_LOG_LEVEL=info
# Disable localhost Host-header protection (set true only if needed).
# SERVER_DISABLE_LOCALHOST_PROTECTION=false
# Serve /mcp in stateless mode.
# SERVER_STATELESS=true
# SERVER_TLS_CERT_FILE=/path/to/mcp-tls-cert.pem
# SERVER_TLS_KEY_FILE=/path/to/mcp-tls-key.pem

# [privx_auth]
PRIVX_PRIVX_BASE_URL=https://privx.example.com
PRIVX_RSA_KEY_FILE=/path/to/private-key.pem
# PRIVX_RSA_PUBLIC_KEY_FILE=/path/to/public-key.pem
PRIVX_RSA_KEY_ID=privx-mcp-key-1
PRIVX_AUDIENCE=privx-mcp-client
PRIVX_TOKEN_ISSUER=privx-mcp
PRIVX_SUBJECT_FORMAT=plain
PRIVX_API_OAUTH_CLIENT_ID=privx-external
PRIVX_API_OAUTH_CLIENT_SECRET=replace-with-secret
PRIVX_API_CLIENT_ID=replace-with-api-client-id
PRIVX_API_CLIENT_SECRET=replace-with-api-client-secret
# PRIVX_CA_CERT=

# [oauth]
OAUTH_ISSUER_URL=https://idp.example.com
OAUTH_SCOPES=openid,profile,email,offline_access
OAUTH_AUDIENCE=privx-mcp-client
OAUTH_ID_CLAIM_FIELD=email
OAUTH_ID_MAPPING_RULE=as-is
# OAUTH_JWKS_URI=https://idp.example.com/.well-known/jwks.json
# OAUTH_JWKS_CACHE_TTL=1h
# OAUTH_DCR_STUB_CLIENT_ID=your-oauth-client-app-id
# OAUTH_DCR_STUB_CLIENT_SECRET=your-oauth-client-app-secret

# [permissions]
PERMISSIONS_DEFAULT_READ_ONLY=true
PERMISSIONS_WHITELIST=-list,-get,-search,echo,mcp-info
PERMISSIONS_BLACKLIST=-delete
PERMISSIONS_SOURCE_TYPE=MICROSOFTGRAPH
PERMISSIONS_SESSION_CACHE_TTL=30s
PERMISSIONS_REFRESH_COOLDOWN=1m
# PERMISSIONS_REQUEST_WINDOW_SECONDS=15
# PERMISSIONS_MAX_REQUESTS_PER_WINDOW=5
# PERMISSIONS_MAXED_WINDOW_WAIT_SECONDS=15
