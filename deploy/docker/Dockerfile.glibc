# == Build stage ==

# glibc image: compile on Debian so the binary links against GNU libc.
FROM debian:bookworm-slim AS build

ARG GO_VERSION=1.26.5

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" -o /tmp/go.tgz \
    && echo "5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053  /tmp/go.tgz" | sha256sum -c - \
    && tar -C /usr/local -xzf /tmp/go.tgz \
    && rm /tmp/go.tgz

ENV PATH=/usr/local/go/bin:${PATH} \
    GOTOOLCHAIN=local \
    CGO_ENABLED=1 \
    GOOS=linux

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o /out/privx-mcp-server ./cmd/privx-mcp-server

# == Runtime stage ==

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgcc-s1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 65532 privx \
    && useradd --uid 65532 --gid privx --home-dir /app --shell /usr/sbin/nologin privx \
    && mkdir -p /app /etc/privx-mcp \
    && chown privx:privx /app /etc/privx-mcp

COPY --from=build --chown=privx:privx /out/privx-mcp-server /usr/local/bin/privx-mcp-server

USER privx
WORKDIR /app
EXPOSE 8181
ENTRYPOINT ["/usr/local/bin/privx-mcp-server"]
