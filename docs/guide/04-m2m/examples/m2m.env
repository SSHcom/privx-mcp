# Machine-to-machine settings for auth_mode=m2m.
# Export these variables into the process environment, or pass this file
# to the service manager.
# Variables override a config file. Do not set OAUTH_* in this mode.
# Guide: docs/guide/04-m2m/04-m2m.md

SERVER_NAME=privx-mcp-server
SERVER_AUTH_MODE=m2m
SERVER_PUBLIC_URL=https://mcp.example.net:8181
SERVER_LOG_LEVEL=info
SERVER_TLS_CERT_FILE=/etc/privx-mcp/mcp-tls-cert.pem
SERVER_TLS_KEY_FILE=/etc/privx-mcp/mcp-tls-key.pem

# Each secret is at least 32 characters. Quotes keep the spaces intact.
SERVER_M2M_IDENTITY_MAPPER="user-1 replace-with-at-least-32-character-secret|user-2 replace-with-another-32-character-secret"

PRIVX_PRIVX_BASE_URL=https://privx.example.net
PRIVX_RSA_KEY_FILE=/etc/privx-mcp/private-key.pem
PRIVX_RSA_PUBLIC_KEY_FILE=/etc/privx-mcp/public-key.pem
PRIVX_RSA_KEY_ID=privx-mcp-key-1
PRIVX_AUDIENCE=privx-mcp-client
PRIVX_TOKEN_ISSUER=privx-mcp
PRIVX_SUBJECT_FORMAT=plain
PRIVX_API_OAUTH_CLIENT_ID=privx-external
PRIVX_API_OAUTH_CLIENT_SECRET=replace-with-secret
PRIVX_API_CLIENT_ID=replace-with-api-client-id
PRIVX_API_CLIENT_SECRET=replace-with-api-client-secret
# PRIVX_CA_CERT=/etc/privx-mcp/privx-ca.pem

PERMISSIONS_DEFAULT_READ_ONLY=true
PERMISSIONS_ENABLE_SENSITIVE_DATA_TOOLS=false
PERMISSIONS_SENSITIVE_DATA_TOOLS_ALLOW_NON_ADMIN=false
PERMISSIONS_RESPONSE_FILTER=sudo,chmod,chown,curl,wget,ping,nslookup,sh,bash,zsh,cmd,exec,eval
PERMISSIONS_SOURCE_TYPE=LOCAL
PERMISSIONS_SESSION_CACHE_TTL=30s
