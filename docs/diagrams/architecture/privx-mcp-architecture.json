  "cards": [
    {
      "dot": "cyan",
      "title": "Edge",
      "items": [
        "Clients speak streamable HTTP at /mcp (no SSE)",
        "RFC 9728 metadata points at the OIDC issuer; the HTTP edge verifies bearer JWTs via JWKS"
      ]
    },
    {
      "dot": "emerald",
      "title": "MCP",
      "items": [
        "Runtime talks to Tools directly on tools/call; Prepare/Wrap still sanitizes untrusted I/O inside the handler wrapper",
        "Tool visibility and call permissions run in a per-user session (cached PrivX roles); the same PermissionEngine filters tools/list and gates tools/call"
      ]
    },
    {
      "dot": "rose",
      "title": "PrivX clients",
      "items": [
        "API-credential client resolves the caller’s roles for both listing and calling",
        "User client exchanges a minted JWT so tool traffic is authorized and audited as that PrivX user"
      ]
    }
  ]
