  "cards": [
    {
      "dot": "rose",
      "title": "HTTP edge",
      "items": [
        "POST /mcp is the streamable MCP endpoint",
        "Bearer JWT is verified before the MCP SDK sees the body",
        "Claims stay on the request context for ClaimsSource"
      ]
    },
    {
      "dot": "emerald",
      "title": "Call pipeline",
      "items": [
        "authMiddleware: Authenticate, rate limit, IsAllowed",
        "createToolHandler: inbound Prepare, then the tool",
        "Trusted tools skip Prepare and the response envelope"
      ]
    },
    {
      "dot": "cyan",
      "title": "Response",
      "items": [
        "Success JSON is sanitized, blacklist-checked, then wrapped",
        "Error results stay unwrapped MCP error text",
        "List/search may drop failing rows instead of rejecting the page"
      ]
    }
  ]
